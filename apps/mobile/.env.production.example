# Copy to .env.local only when building a native app for the production API.
# Register JustTaken's own Apple / Google applications before filling these IDs.
EXPO_PUBLIC_API_URL=https://justtaken.app
JUSTTAKEN_BUNDLE_ID=
JUSTTAKEN_ANDROID_PACKAGE=
APPLE_TEAM_ID=
APP_ATTEST_ENVIRONMENT=production
GOOGLE_CLOUD_PROJECT_NUMBER=
# Re-run prebuild and rebuild after changing the API origin or app IDs.
