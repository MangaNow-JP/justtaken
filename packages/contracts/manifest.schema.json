{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "policyVersion": {
      "type": "string",
      "enum": [
        "capture-v1",
        "capture-v2",
        "capture-v3"
      ]
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "installationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "accountBindingId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "clientCaptureId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "clientCapturedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "photo",
        "video"
      ]
    },
    "assets": {
      "minItems": 2,
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "original",
              "thumbnail",
              "poster"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "original",
              "thumbnail",
              "poster"
            ]
          },
          "mime": {
            "type": "string",
            "enum": [
              "image/jpeg",
              "image/heic",
              "image/x-adobe-dng",
              "video/mp4"
            ]
          },
          "bytes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "width": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "height": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "preservation": {
            "type": "string",
            "const": "camera-original"
          },
          "hasGainMap": {
            "type": "boolean"
          },
          "durationMs": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "videoCodec": {
            "type": "string",
            "enum": [
              "h264",
              "hevc"
            ]
          },
          "orientation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "rotationDegrees": {
            "anyOf": [
              {
                "type": "number",
                "const": 0
              },
              {
                "type": "number",
                "const": 90
              },
              {
                "type": "number",
                "const": 180
              },
              {
                "type": "number",
                "const": 270
              }
            ]
          },
          "videoBitDepth": {
            "anyOf": [
              {
                "type": "number",
                "const": 8
              },
              {
                "type": "number",
                "const": 10
              }
            ]
          },
          "colorTransfer": {
            "type": "string",
            "enum": [
              "sdr",
              "hlg",
              "pq"
            ]
          },
          "audioCodec": {
            "type": "string",
            "const": "aac-lc"
          },
          "fpsNumerator": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "fpsDenominator": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "role",
          "mime",
          "bytes",
          "width",
          "height",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "policyVersion",
    "sessionId",
    "installationId",
    "accountBindingId",
    "clientCaptureId",
    "nonce",
    "clientCapturedAt",
    "kind",
    "assets"
  ],
  "additionalProperties": false,
  "title": "JustTaken capture manifest v1",
  "description": "Structural schema. Apply manifestSchema at runtime for cross-field role, size, duration and codec rules."
}
