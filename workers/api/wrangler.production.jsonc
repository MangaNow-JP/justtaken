{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "justtaken-api",
  "account_id": "7f4900aa1dc020f7b8478b93b2b05191",
  "main": "src/index.ts",
  "build": {
    "command": "node -e \"import(require.resolve('@justtaken/api/verifier-build'))\"",
    "watch_dir": [
      "web",
      "src/proof-verify.ts",
      "src/anchor-crypto.ts",
      "src/anchor-client.ts",
      "src/anchor-trust.ts",
      "../../packages/contracts/src",
    ],
  },
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "run_worker_first": [
      "/v1/*",
      "/public/*",
      "/.well-known/*",
      "/verify",
      "/verify.js",
      "/verify-hash.js",
      "/health",
    ],
  },
  "routes": [
    {
      "pattern": "justtaken.app",
      "zone_id": "ed9f184e5d9f5ea5c4493cab63fcf5d4",
      "custom_domain": true,
    },
  ],
  "secrets": {
    "required": ["RECEIPT_PRIVATE_JWK", "RECEIPT_KEY_ID", "MEDIA_SECRET"],
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
  "vars": {
    "ENVIRONMENT": "production",
    "PROOF_ANCHOR_PROVIDER": "sigstore-v1",
    "API_ORIGIN": "https://justtaken.app",
    "APP_RETURN_URL": "justtaken-dev://auth",
    "ALLOWED_ORIGINS": "https://justtaken.app",
  },
  "d1_databases": [
    {
      "binding": "HOME",
      "database_name": "justtaken-home-production",
      "database_id": "77408729-6699-4d3b-a5b8-b4f30b16d71c",
      "migrations_dir": "migrations/home",
    },
  ],
  "r2_buckets": [
    { "binding": "STAGING", "bucket_name": "justtaken-staging-production" },
    { "binding": "ORIGINALS", "bucket_name": "justtaken-originals-production" },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "AUTH", "class_name": "AuthSession" },
      { "name": "CAPTURE", "class_name": "CaptureSecurity" },
    ],
  },
  "ratelimits": [
    { "name": "REQUEST_LIMIT", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
    {
      "name": "EARLY_ACCESS_LIMIT",
      "namespace_id": "1003",
      "simple": { "limit": 6, "period": 60 },
    },
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AuthSession", "CaptureSecurity"] }],
  "triggers": { "crons": ["*/5 * * * *"] },
}
